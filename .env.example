# Copy to .env for a local `docker compose up`. The .env file is gitignored.

# LiteLLM master key for the local proxy. Must start with "sk-".
# Generate one with:  echo "sk-$(openssl rand -hex 24)"
# sk-REPLACE-ME is a placeholder that is published in this repository. Compose
# runs with it unless you replace it here or export your own key, so do one of
# the two before `docker compose up`.
LITELLM_MASTER_KEY=sk-REPLACE-ME

# Region whose Amazon Bedrock endpoint LiteLLM calls. Must be the Region where
# you enabled model access. Global inference profiles can still serve the
# request from other commercial Regions.
# Note: an AWS_REGION exported in your shell takes precedence over this file
# (standard Docker Compose behavior).
AWS_REGION=us-east-1

# Profile directory under profiles/. Stage is the default.
ROUTING_PROFILE=stage

# Local LiteLLM proxy port.
LITELLM_PORT=4000

# AWS credentials are not stored here. Export them into your shell before
# starting Compose:
#   eval "$(aws configure export-credentials --format env)"
# They are short-lived session credentials; rerun the command when they expire.
