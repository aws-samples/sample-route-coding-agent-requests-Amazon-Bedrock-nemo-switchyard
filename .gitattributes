# Normalize line endings so shell scripts and Dockerfiles work on every platform.
* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.drawio text
