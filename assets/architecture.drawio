="c140" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="643" y="384" width="28" height="28" as="geometry"/></mxCell><mxCell id="c141" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1064" y="200" width="28" height="28" as="geometry"/></mxCell><mxCell id="c142" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1240" y="384" width="28" height="28" as="geometry"/></mxCell><mxCell id="c143" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="432" width="28" height="28" as="geometry"/></mxCell><mxCell id="c144" value="&lt;table style=&quot;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;The agent sends an OpenAI-compatible HTTPS request with the gateway key.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;AWS WAF filters it. The load balancer admits the allowed CIDR and 3 API paths.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;LiteLLM checks the key. The Switchyard plugin picks the model.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;LiteLLM calls Amazon Bedrock through the VPC endpoint with the task IAM role.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;The response returns the same way, with the x-litellm-model-name header.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#AAB7B8;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="700" width="480" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
